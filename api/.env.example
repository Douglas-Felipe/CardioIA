# Configurações do IBM Watson Assistant (Opcional - caso não configurado, o motor local será acionado automaticamente)
WATSON_API_KEY=your_ibm_watson_api_key_here
WATSON_SERVICE_URL=https://api.us-south.assistant.watson.cloud.ibm.com
WATSON_ASSISTANT_ID=your_assistant_id_here
WATSON_VERSION=2021-06-14

# Configurações da Aplicação Flask
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
HOST=0.0.0.0
